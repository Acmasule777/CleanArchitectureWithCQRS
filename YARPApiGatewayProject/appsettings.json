{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Key": "U51eFEfci9gBVUbDNbgm9s60WCtRPrEOCCat5l+Lusc=",
    "Issuer": "AuthService",
    "Audience": "Microservices"
  },

    "ReverseProxy": {
      "Routes": {
        "employee-routes": {
          "ClusterId": "employee-cluster",
          "AuthorizationPolicy": "authenticated",
          "Match": {
            "Path": "api/Employee/{**catch-all}"
          }
        },
        "department-routes": {
          "ClusterId": "department-cluster",
          "AuthorizationPolicy": "authenticated",
          "Match": {
            "Path": "api/Department/{**catch-all}"
          }
        },

        "authService-routes": {
          "ClusterId": "auth-cluster",
          "Match": {
            "Path": "api/AuthService/{**catch-all}"
          }
        },
        "payroll-routes": {
          "ClusterId": "payroll-cluster",
          "AuthorizationPolicy": "authenticated",
          "Match": {
            "Path": "api/Payroll/{**catch-all}"
          }
        }
      },

      "Clusters": {
        "employee-cluster": {
          "Destinations": {
            "employee-api": {
              "Address": "http://localhost:5135/"
            }
          }
        },
        "department-cluster": {
          "Destinations": {
            "department-api": {
              "Address": "http://localhost:5297/"
            }
          }
        },
        "auth-cluster": {
          "Destinations": {
            "auth-api": {
              "Address": "http://localhost:5035/"
            }
          }
        },
        "payroll-cluster": {
          "Destinations": {
            "payroll-api": {
              "Address": "http://localhost:5233/"
            }
          }
        }
      }
    }
  }
